#!/bin/bash -p

# Raspberry Pi headless first boot. omarchy-rpi-boot installs it as
# /usr/lib/omarchy/rpi-boot/headless, which omarchy-rpi-headless.service runs on
# an image's first boot, while first-boot setup is pending.
#
# An image is set up at its screen, by the owner wizard on tty1. A Pi with no
# screen or keyboard gets its settings from pimarchy.txt on the FAT boot
# partition instead, which its owner fills in on the computer that flashed the
# card (the image ships every setting in it empty). Before NetworkManager and
# Avahi start, this:
#
# - sets the Wi-Fi radio's country and gives NetworkManager a profile for the
#   owner's network;
# - names the machine and sets its timezone, so DHCP and mDNS announce the
#   owner's hostname from the start;
# - leaves the account's answers to first-boot setup, which then runs with
#   nobody at the screen (bin/omarchy-provision-owner), and stages the owner's
#   SSH keys for it;
# - turns SSH on, with password logins off once there is a key;
# - blanks the passwords in pimarchy.txt where they lie, with every line it
#   could not read, and writes what it did to pimarchy-status.txt beside it.
#
# The file is read as data, never sourced, and checked by the owner form's own
# rules (install/provisioning/setup-form.sh), so owner setup takes whatever this
# stages. A setting this can't use is skipped and reported. Without an account
# the owner wizard asks at the screen as before, and a Wi-Fi profile or account
# staged by an earlier run stays when a rerun finds its passwords blanked.
#
# The unit runs this with nothing in its environment but a fixed PATH, so it
# uses fixed paths and checks the platform itself. An unprivileged test may name
# a fixture root in OMARCHY_RPI_BOOT_ROOT, which prefixes every path this opens,
# and stub the tools on its PATH; root ignores both.
if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

set -euo pipefail
shopt -s inherit_errexit
umask 077
# Lengths below are in bytes, as an SSID's and a password's limits are, and as
# blanking a line in place needs.
export LC_ALL=C

fail() {
  echo "Error: $*" >&2
  exit 1
}

if (( $# != 0 )); then
  echo "Usage: headless" >&2
  exit 2
fi

if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
  fixture=""
  is_rpi=/usr/bin/omarchy-hw-aarch64-rpi
else
  fixture=${OMARCHY_RPI_BOOT_ROOT:-}
  [[ -n $fixture ]] || fail "headless runs as root"
  [[ $fixture == /* ]] || fail "OMARCHY_RPI_BOOT_ROOT must be an absolute path"
  fixture=${fixture%/}
  is_rpi=omarchy-hw-aarch64-rpi
fi

"$is_rpi" || fail "headless sets up a Raspberry Pi, and this is not a Raspberry Pi"

settings=$fixture/boot/pimarchy.txt
report=$fixture/boot/pimarchy-status.txt
provisioning=$fixture/var/lib/omarchy/provisioning
answers=$provisioning/answers
form=$fixture/usr/share/omarchy/install/provisioning/setup-form.sh
regdom=$fixture/etc/conf.d/wireless-regdom
connections=$fixture/etc/NetworkManager/system-connections
profile=$connections/pimarchy-wifi.nmconnection
hardening=$fixture/etc/ssh/sshd_config.d/10-omarchy-hardening.conf
zoneinfo=$fixture/usr/share/zoneinfo
passwd=$fixture/etc/passwd
group=$fixture/etc/group

# First-boot setup is done, or the owner deleted the file.
[[ -f $provisioning/pending ]] || exit 0
[[ -f $settings && ! -L $settings ]] || exit 0

# Root sources the form's rules, so they must be root's (the caller's own inside
# a fixture), as must their directory, and writable by nobody else.
owned() {
  local path=$1 owner mode

  [[ -e $path && ! -L $path ]] || return 1
  read -r owner mode < <(stat -c '%u %a' -- "$path") || return 1
  (( owner == EUID && (8#$mode & 8#022) == 0 ))
}

if ! owned "$form" || ! owned "${form%/*}"; then
  fail "refusing $form: it must be a root-owned file in a root-owned directory, writable by no one else"
fi
OMARCHY_FORM_DEFAULTS=$fixture/etc/omarchy/form-defaults
source "$form"

declare -A known=() secret=() setting=()
for key in WIFI_SSID WIFI_PASSWORD WIFI_COUNTRY WIFI_HIDDEN USERNAME PASSWORD PASSWORD_HASH FULL_NAME EMAIL HOSTNAME \
  TIMEZONE KEYBOARD SSH_KEY SSH_PASSWORD_LOGIN; do
  known[$key]=1
done
for key in WIFI_PASSWORD PASSWORD PASSWORD_HASH; do
  secret[$key]=1
done
ssh_keys=()
ssh_key_lines=()
skipped=()
applied=()
# The account owner setup will create, and the hostname it will give the
# machine, for the status file's ssh command.
account=""
account_host=""

# Sets the variable named $1 to $2 without leading or trailing whitespace.
trim() {
  local text=$2

  text=${text#"${text%%[![:space:]]*}"}
  printf -v "$1" '%s' "${text%"${text##*[![:space:]]}"}"
}

# The setting a line sets: its key in capitals, or nothing for a blank line, a
# comment or a line with no "=". A UTF-8 byte order mark and a CR, as a Windows
# editor leaves them, go.
line_key() {
  local line=${1#$'\xef\xbb\xbf'}

  trim line "${line%$'\r'}"
  [[ -n $line && $line != \#* && $line == *=* ]] || return 1
  trim line "${line%%=*}"
  printf '%s' "${line^^}"
}

# Whether $1, as line_key gives it, is a setting this knows. The pattern comes
# first, so no key reaches the array lookup with characters it would read.
known_key() {
  [[ $1 =~ ^[A-Z][A-Z_]*$ && -v known[$1] ]]
}

# The value a setting line gives, trimmed: double or single quotes around it go,
# and keep its own leading and trailing spaces.
line_value() {
  local value=${1#*=}

  trim value "${value%$'\r'}"
  if (( ${#value} >= 2 )) && [[ $value == \"*\" || $value == \'*\' ]]; then
    value=${value:1:${#value}-2}
  fi
  printf '%s' "$value"
}

# Whether blanking keeps line $1: a comment, a blank line, or a setting this
# knows that holds no password. A line it can't read could hold anything, and
# an empty password line goes too, so a rerun can't take the template's empty
# WIFI_PASSWORD for an open network once the owner's own line is blanked. It
# runs from the exit trap, where a bare return gives the status from before the
# trap, so every return names its own.
keeps_line() {
  local key line

  if ! key=$(line_key "$1"); then
    trim line "${1#$'\xef\xbb\xbf'}"
    if [[ -z $line || $line == \#* ]]; then
      return 0
    fi
    return 1
  fi
  if known_key "$key" && [[ ! -v secret[$key] ]]; then
    return 0
  fi
  return 1
}

# ── Blanking and reporting ───────────────────────────────────────────────────

# Every line keeps_line refuses becomes a comment of the same length, written
# over the old bytes in place: renaming a new file over it would free the old
# clusters with the passwords still in them. The status file says where they
# went, and a rerun reads the blanked lines as comments. These run from the
# exit trap, where errexit is off, so every step checks itself.
blank_passwords() {
  local -a lines
  local i body cr size content="" blanked=0

  mapfile -t lines <"$settings" || return 1
  for i in "${!lines[@]}"; do
    ! keeps_line "${lines[i]}" || continue
    cr=""
    if [[ ${lines[i]} == *$'\r' ]]; then
      cr=$'\r'
    fi
    body=${lines[i]%$'\r'}
    printf -v "lines[$i]" '#%*s%s' "$(( ${#body} - 1 ))" "" "$cr" || return 1
    blanked=1
  done
  (( blanked )) || return 0

  for i in "${!lines[@]}"; do
    content+=${lines[i]}$'\n'
  done
  if [[ -n $(tail -c 1 -- "$settings") ]]; then
    content=${content%$'\n'}
  fi
  # Shorter, the rewrite would leave the old bytes past its end.
  size=$(stat -c %s -- "$settings") || return 1
  (( ${#content} == size )) || return 1
  printf '%s' "$content" 1<>"$settings" || return 1
  sync
  applied+=("the passwords in pimarchy.txt blanked, with every line it could not read")
}

# The report is composed first and written in one checked step, so a failed
# write never replaces the last one.
write_report() {
  local text part

  printf -v text '# What the Pi did with pimarchy.txt on its first boot, %s UTC.\n\nApplied:\n' "$(date -u '+%Y-%m-%d %H:%M')"
  printf -v part -- '- %s\n' "${applied[@]:-nothing}"
  text+=$part
  if (( ${#skipped[@]} )); then
    printf -v part -- '- %s\n' "${skipped[@]}"
    text+=$'\nSkipped:\n'$part
  fi
  if [[ -n $account ]]; then
    printf -v part '\nOnce it has set up the account, reach it with:  ssh %s@%s.local\n' "$account" "${account_host:-$OMARCHY_HOSTNAME_DEFAULT}"
    text+=$part
  fi
  printf '%s' "$text" >"$report.new" || return 1
  mv -f "$report.new" "$report" || return 1
  sync
}

# ── Reading pimarchy.txt ─────────────────────────────────────────────────────

# Only plain text can be read and blanked line by line. Bash drops NUL bytes,
# so a file saved as UTF-16 would parse while blanking missed every line, and a
# lone CR ends a line for its editor but not here. Such a file is used for
# nothing, so its passwords stay where its owner put them, as before the boot.
size=$(stat -c %s -- "$settings")
not_text=""
if (( size > 65536 )); then
  not_text="it is over 64 KiB"
elif (( $(tr -d '\0' <"$settings" | wc -c) != size )); then
  not_text="it holds NUL bytes, as a file saved as UTF-16 does"
elif grep -q $'\r.' "$settings"; then
  not_text="its lines end in a CR alone"
fi
if [[ -n $not_text ]]; then
  skipped+=("pimarchy.txt: unread, since $not_text. Save it as plain text (UTF-8) and boot again")
  write_report
  exit 0
fi

# A line it can't read is reported by its number, and by its key only when that
# looks like one: the text before a stray "=" could be a password.
number=0
while IFS= read -r line || [[ -n $line ]]; do
  number=$(( number + 1 ))
  if ! key=$(line_key "$line"); then
    trim line "${line#$'\xef\xbb\xbf'}"
    [[ -z $line || $line == \#* ]] || skipped+=("line $number: no \"=\", so it sets nothing")
    continue
  fi
  if ! known_key "$key"; then
    if [[ $key =~ ^[A-Z][A-Z0-9_]{0,31}$ ]]; then
      skipped+=("line $number: there is no setting $key")
    else
      skipped+=("line $number: no setting this knows")
    fi
    continue
  fi
  value=$(line_value "$line")
  if [[ $key == "SSH_KEY" ]]; then
    if [[ -n $value ]]; then
      ssh_keys+=("$value")
      ssh_key_lines+=("$number")
    fi
  elif [[ -n $value ]]; then
    if [[ -n ${setting[$key]:-} ]]; then
      skipped+=("$key: given more than once, so line $number's is used")
    fi
    setting[$key]=$value
  elif [[ ! -v setting[$key] ]]; then
    # An empty line only says the setting is there: the template's empty lines
    # don't undo a value given above them.
    setting[$key]=""
  fi
done <"$settings"

has() { [[ -v setting[$1] ]]; }
get() { printf '%s' "${setting[$1]:-}"; }

# As the image ships it, every setting empty, apart from the two that only
# change how others apply.
in_use=$(( ${#ssh_keys[@]} + ${#skipped[@]} ))
for key in "${!setting[@]}"; do
  if [[ $key != "WIFI_HIDDEN" && $key != "SSH_PASSWORD_LOGIN" && -n ${setting[$key]} ]]; then
    in_use=1
  fi
done
(( in_use )) || exit 0

# However the run ends, the passwords go and the owner learns what happened:
# the status file is all a Pi with no screen can tell them.
finish() {
  local status=$?

  trap - EXIT
  if (( status != 0 )); then
    skipped+=("the rest: setup stopped at an error, which journalctl -u omarchy-rpi-headless shows")
  fi
  if ! blank_passwords; then
    skipped+=("blanking the passwords in pimarchy.txt failed: delete them by hand")
    status=1
  fi
  write_report || status=1
  exit "$status"
}
trap finish EXIT
# Stopped by a signal, the exit trap would read the status from before it.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

yes_no() {
  case ${1,,} in
    yes | true | on | 1) return 0 ;;
    no | false | off | 0 | "") return 1 ;;
    *) return 2 ;;
  esac
}

# A name timedated lists, as owner setup checks it: a zone or a link in the
# tz database's tzdata.zi, with its file under zoneinfo.
timezone_known() {
  [[ $1 =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f $zoneinfo/$1 && -f $zoneinfo/tzdata.zi ]] || return 1
  awk -v tz="$1" '
    ($1 == "Z" || $1 == "Zone") && $2 == tz { found = 1 }
    ($1 == "L" || $1 == "Link") && $3 == tz { found = 1 }
    END { exit !found }
  ' "$zoneinfo/tzdata.zi"
}

# ── The machine ──────────────────────────────────────────────────────────────

hostname=""
if [[ -n $(get HOSTNAME) ]]; then
  if [[ $(get HOSTNAME) =~ $OMARCHY_HOSTNAME_PATTERN ]]; then
    hostname=$(get HOSTNAME)
    install -m 0644 /dev/null "$fixture/etc/hostname"
    printf '%s\n' "$hostname" >"$fixture/etc/hostname"
    printf '%s\n' "$hostname" >"$fixture/proc/sys/kernel/hostname"
    applied+=("hostname $hostname")
  else
    skipped+=("HOSTNAME: letters, digits and dashes, 63 at most, starting and ending with a letter or digit")
  fi
fi

timezone=""
if [[ -n $(get TIMEZONE) ]]; then
  if timezone_known "$(get TIMEZONE)"; then
    timezone=$(get TIMEZONE)
    ln -sfn "../usr/share/zoneinfo/$timezone" "$fixture/etc/localtime"
    applied+=("timezone $timezone")
  else
    skipped+=("TIMEZONE: no timezone is named $(get TIMEZONE)")
  fi
fi

keyboard=""
if [[ -n $(get KEYBOARD) ]]; then
  if omarchy_keyboard_select "$(get KEYBOARD)"; then
    keyboard=$(get KEYBOARD)
  else
    skipped+=("KEYBOARD: no layout is named $(get KEYBOARD)")
  fi
fi

# ── Wi-Fi ────────────────────────────────────────────────────────────────────

country=""
if [[ -n $(get WIFI_COUNTRY) ]]; then
  country=$(get WIFI_COUNTRY)
  country=${country^^}
  if [[ $country =~ ^[A-Z]{2}$ ]] && grep -qE "^#?WIRELESS_REGDOM=\"$country\"" "$regdom" 2>/dev/null; then
    # A setting already made from the timezone gives way; hardware setup keeps
    # whatever is set by the time it runs.
    sed -i -e 's/^WIRELESS_REGDOM=/#WIRELESS_REGDOM=/' -e "s/^#WIRELESS_REGDOM=\"$country\"/WIRELESS_REGDOM=\"$country\"/" "$regdom"
    set-wireless-regdom >/dev/null 2>&1 || true
    applied+=("Wi-Fi country $country")
  else
    skipped+=("WIFI_COUNTRY: no country's radio rules are named $(get WIFI_COUNTRY)")
    country=""
  fi
fi

# A GLib key file string: backslashes doubled, and spaces as \s so none is
# trimmed. psk_valid keeps out the control characters that would need more.
keyfile_string() {
  local text=${1//\\/\\\\}

  printf '%s' "${text// /\\s}"
}

# The SSID as its bytes, which no character in it can be mistaken in.
ssid_bytes() {
  local byte out=""

  for byte in $(printf '%s' "$1" | od -An -v -tu1); do
    out+="$byte;"
  done
  printf '%s' "$out"
}

# A WPA passphrase: 8 to 63 bytes with no control characters, valid UTF-8 as
# NetworkManager reads its key files, or the key itself as 64 hex digits.
psk_valid() {
  if [[ $1 =~ ^[[:xdigit:]]{64}$ ]]; then
    return 0
  fi
  [[ $1 =~ ^[^[:cntrl:]]{8,63}$ ]] && printf '%s' "$1" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1
}

ssid=$(get WIFI_SSID)
if [[ -n $ssid ]]; then
  psk=$(get WIFI_PASSWORD)
  hidden=false
  wifi_ok=1
  if (( ${#ssid} > 32 )); then
    skipped+=("WIFI_SSID: a network's name is 32 bytes at most")
    wifi_ok=0
  fi
  if ! has WIFI_PASSWORD; then
    # Blanked by an earlier run, whose profile stays if it is for this network.
    if [[ ! -f $profile ]]; then
      skipped+=("WIFI_SSID: no WIFI_PASSWORD line (keep it, empty, for an open network)")
    elif grep -qxF "ssid=$(ssid_bytes "$ssid")" "$profile"; then
      applied+=("Wi-Fi network \"$ssid\", set up on an earlier boot")
    else
      skipped+=("WIFI_SSID: an earlier boot set up another network; add a WIFI_PASSWORD line for this one")
    fi
    wifi_ok=0
  elif [[ -n $psk ]] && ! psk_valid "$psk"; then
    skipped+=("WIFI_PASSWORD: 8 to 63 characters (a letter beyond plain English may count as two or three), or 64 hex digits")
    wifi_ok=0
  fi
  if yes_no "$(get WIFI_HIDDEN)"; then
    hidden=true
  elif (( $? == 2 )); then
    skipped+=("WIFI_HIDDEN: yes or no")
  fi

  if (( wifi_ok )); then
    install -d -m 0700 "$connections"
    uuid=$(</proc/sys/kernel/random/uuid)
    {
      printf '[connection]\nid=pimarchy-wifi\nuuid=%s\ntype=wifi\nautoconnect=true\n\n' "$uuid"
      printf '[wifi]\nmode=infrastructure\nssid=%s\n' "$(ssid_bytes "$ssid")"
      if [[ $hidden == true ]]; then
        printf 'hidden=true\n'
      fi
      if [[ -n $psk ]]; then
        printf '\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n' "$(keyfile_string "$psk")"
      fi
      printf '\n[ipv4]\nmethod=auto\n\n[ipv6]\naddr-gen-mode=default\nmethod=auto\n'
    } >"$profile.new"
    chmod 600 "$profile.new"
    mv -f "$profile.new" "$profile"
    if [[ -n $psk ]]; then
      applied+=("Wi-Fi network \"$ssid\" with its password")
    else
      applied+=("Wi-Fi network \"$ssid\", open, since WIFI_PASSWORD is empty")
    fi
  fi
elif [[ -n $(get WIFI_PASSWORD) ]]; then
  skipped+=("WIFI_PASSWORD: no WIFI_SSID names the network")
fi

# ── The account ──────────────────────────────────────────────────────────────

full_name=$(get FULL_NAME)
if [[ $full_name == *:* ]]; then
  skipped+=("FULL_NAME: no colons")
  full_name=""
fi

# The form's answers for owner setup: account $1 with password line $2.
write_answers() {
  {
    printf 'USERNAME=%s\n%s\n' "$1" "$2"
    printf 'FULL_NAME=%s\nEMAIL=%s\n' "$full_name" "$(get EMAIL)"
    printf 'HOSTNAME=%s\nTIMEZONE=%s\nKEYBOARD=%s\n' "$hostname" "$timezone" "$keyboard"
  } >"$answers.new"
  chmod 600 "$answers.new"
  mv -f "$answers.new" "$answers"
}

# Whether no account or group has name $1: useradd makes a group of the
# account's name, and refuses one that exists. A file it can't read answers no.
name_free() {
  local status=0

  awk -F: -v name="$1" '$1 == name { found = 1 } END { exit !found }' "$passwd" "$group" 2>/dev/null || status=$?
  (( status == 1 ))
}

# The account an earlier attempt of owner setup created before it failed, which
# owner setup resumes and no other.
pinned=""
if [[ -f $provisioning/setup-user ]]; then
  pinned=$(<"$provisioning/setup-user")
fi

username=$(get USERNAME)
password_line=""
if [[ -n $(get PASSWORD_HASH) ]]; then
  if [[ $(get PASSWORD_HASH) =~ ^\$[0-9a-z]+\$[^:[:space:]]+$ ]]; then
    password_line="PASSWORD_HASH=$(get PASSWORD_HASH)"
  else
    skipped+=("PASSWORD_HASH: a crypt(3) hash, such as openssl passwd -6 makes")
  fi
elif [[ -n $(get PASSWORD) ]]; then
  password_line="PASSWORD=$(get PASSWORD)"
fi

if [[ -n $password_line ]]; then
  if [[ -z $username ]]; then
    skipped+=("PASSWORD: no USERNAME for it")
  elif [[ ! $username =~ $OMARCHY_USERNAME_PATTERN || $username =~ $OMARCHY_RESERVED_USERNAMES ]]; then
    skipped+=("USERNAME: lowercase letters, digits, - and _, starting with a letter, and not a system account's name")
  elif [[ -n $pinned && $username != "$pinned" ]]; then
    skipped+=("USERNAME: an earlier boot already created the account $pinned, which setup finishes")
  elif [[ -z $pinned ]] && ! name_free "$username"; then
    skipped+=("USERNAME: the image already has an account or group named $username")
  else
    write_answers "$username" "$password_line"
    applied+=("account $username, created when first-boot setup runs")
  fi
elif [[ -f $answers ]]; then
  # Staged by an earlier run whose passwords are blanked now: it keeps its
  # account and password, and takes this file's other settings.
  staged=$(sed -n 's/^USERNAME=//p' "$answers")
  if [[ -z $username || $username == "$staged" ]]; then
    write_answers "$staged" "$(grep -m 1 -E '^(PASSWORD|PASSWORD_HASH)=' "$answers")"
    applied+=("account $staged, set up on an earlier boot")
  else
    skipped+=("USERNAME: an earlier boot set up the account $staged; give $username a PASSWORD to set it up instead")
  fi
elif [[ -n $username ]]; then
  skipped+=("USERNAME: no PASSWORD or PASSWORD_HASH for it")
fi
if [[ -f $answers ]]; then
  account=$(sed -n 's/^USERNAME=//p' "$answers")
  account_host=$(sed -n 's/^HOSTNAME=//p' "$answers")
fi

# ── SSH ──────────────────────────────────────────────────────────────────────

# A key as a .pub file holds it: its type first. ssh-keygen also reads a line
# with options or a known_hosts entry, which sshd would ignore in
# authorized_keys while password logins went off for it.
keys=()
for i in "${!ssh_keys[@]}"; do
  key=${ssh_keys[i]}
  if [[ ${key%%[[:space:]]*} =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)$ ]] &&
    ssh-keygen -lf /dev/stdin <<<"$key" >/dev/null 2>&1; then
    keys+=("$key")
  else
    skipped+=("SSH_KEY on line ${ssh_key_lines[i]}: not a public key, as a .pub file holds it")
  fi
done

# What this run's file authorizes replaces what an earlier run staged.
password_logins=1
if (( ${#keys[@]} )); then
  printf '%s\n' "${keys[@]}" >"$provisioning/authorized_keys.new"
  chmod 600 "$provisioning/authorized_keys.new"
  mv -f "$provisioning/authorized_keys.new" "$provisioning/authorized_keys"
  password_logins=0
else
  rm -f "$provisioning/authorized_keys"
fi
if yes_no "$(get SSH_PASSWORD_LOGIN)"; then
  password_logins=1
elif (( $? == 2 )); then
  skipped+=("SSH_PASSWORD_LOGIN: yes or no")
fi

if [[ -n $account ]] || (( ${#keys[@]} )); then
  if (( password_logins )); then
    rm -f "$hardening"
  else
    # As omarchy-setup-security-sshd writes it, so omarchy-remove-security-sshd
    # and its documentation cover it. sshd -t can't check it before the host
    # keys exist; its two settings are fixed.
    install -d -m 0755 "${hardening%/*}"
    install -m 0644 /dev/null "$hardening"
    printf '%s\n' "# Written by the Pi's headless first boot, since an SSH key was authorized." \
      "# Delete this file and reload sshd to allow password logins again." \
      "PasswordAuthentication no" "KbdInteractiveAuthentication no" >"$hardening"
  fi
  # Queued, not waited for: sshd is ordered after this unit.
  if systemctl --no-reload enable sshd.service >/dev/null 2>&1 && systemctl start --no-block sshd.service; then
    applied+=("SSH on, with ${#keys[@]} key(s); password logins $( (( password_logins )) && echo on || echo off)")
  else
    skipped+=("SSH: sshd would not start")
  fi
  ufw limit 22/tcp comment "omarchy-sshd" >/dev/null 2>&1 || skipped+=("SSH: the firewall did not open port 22")
fi

if [[ -n $keyboard && -z $account ]]; then
  skipped+=("KEYBOARD: it comes with the account; without one the screen asks for it")
fi
