#!/bin/bash

# mkinitcpio install file for the omarchy-rpi-disk-id hook
# (/usr/lib/initcpio/hooks/omarchy-rpi-disk-id). It uses busybox's dd,
# hexdump, sed and partprobe, which the base hook adds, util-linux's mount, and
# the kernel's built-in vfat.

build() {
    add_runscript
}

help() {
    cat <<HELPEOF
Gives a flashed Pimarchy image's disk an MBR identifier of its own on its first
boot, when the kernel command line carries pimarchy.new_disk_id, and points
fstab and cmdline.txt at the new PARTUUIDs. Without the flag it does nothing.
HELPEOF
}
